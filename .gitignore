# =============================================================================
# OBSIDIAN
# =============================================================================
# Only app.json and core-plugins.json ship with the template - they carry
# settings the documentation method depends on (link auto-update, properties
# view). Everything else below is per-machine taste or state.
#
# Every pattern is written **/.obsidian/... on purpose. A gitignore pattern
# containing a slash is anchored to the directory holding this file, so a bare
# ".obsidian/workspace.json" matches the repository root and nothing else -
# while a project of this shape carries a second Obsidian folder inside
# 00_documentation/01_projectvault/, whose workspace file was therefore never
# ignored and showed up as untracked on every status.

# User-specific workspace (open tabs, pane layout, etc.)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/workspace-*.json

# Graph view tuning and theme choice - personal
**/.obsidian/graph.json
**/.obsidian/appearance.json

# Community plugins are not shipped: listing them without installing only
# produces load errors for template users.
**/.obsidian/community-plugins.json
**/.obsidian/plugins/

# Local caches
**/.obsidian/cache
.trash/

# =============================================================================
# A.I.
# =============================================================================
# The mechatronics-docs skill ships WITH this template - keep .claude/skills/
# tracked. The method's own decision record is a vault and ships too, so
# .claude/01_methodvault/ is re-included as well: git cannot re-include a file
# under an excluded DIRECTORY, so both exceptions name the directory itself and
# must stay below the '.claude/*' line. Only machine-local Claude Code state is
# ignored.
.claude/*
!.claude/skills/
!.claude/01_methodvault/
.claude/skills/**/__pycache__/
.claude/settings.local.json

# =============================================================================
# OPERATING SYSTEM
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# =============================================================================
# IDE / EDITORS
# =============================================================================
# VS Code (user settings, not project config)
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# =============================================================================
# CAD SOFTWARE
# =============================================================================
# KiCad
*-backups/
*.kicad_prl
fp-info-cache

# Autodesk Inventor
*.ipj
OldVersions/

# FreeCAD
*.FCStd1
*.FCBak

# =============================================================================
# BUILD / COMPILATION
# =============================================================================
# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
ENV/

# C/C++
*.o
*.obj
*.exe
*.out
*.app
*.so
*.dylib

# Node.js
node_modules/
npm-debug.log*

# =============================================================================
# TEMPORARY / CACHE
# =============================================================================
*.tmp
*.temp
*.log
*.cache
.cache/

# =============================================================================
# LARGE FILES (consider using Git LFS instead)
# =============================================================================
# Uncomment if you want to ignore large binary files by default
# *.zip
# *.tar.gz
# *.rar
# *.7z

# =============================================================================
# SENSITIVE / PERSONAL
# =============================================================================
# Environment files with secrets
.env
.env.local
*.env

# Credentials
credentials.json
secrets.json
*.pem
*.key
